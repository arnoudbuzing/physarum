Cell[TextData[{
 "In the Tero ",
 StyleBox["et al.", "TI"],
 " model, protoplasm flows through a network of tubes where each tube has \
length ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["L", "TI"], 
   StyleBox["e", "TI"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15ea55a9-2466-494d-9249-b1aa3d13849f"],
 " and conductivity ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["D", "TI"], 
   StyleBox["e", "TI"]]], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c3a49aa-bbe5-43bb-a1fa-8f5008d40b4d"],
 " (initially ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c544733b-858c-418b-8d59-94179ac9b63b"],
 ")."
}], "Notes",
 CellID->515379898,ExpressionUUID->"6261d154-49c1-45c8-b66b-d456d3c056c6"],

Cell[TextData[{
 "At each step, one food source pumps in flux ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["I", "TI"], "0"]], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63260983-c91d-4698-aa9c-639c5eed2d26"],
 " (",
 Cell[BoxData["\"\<Flux\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7a5e3c37-fe84-4c0e-bbbc-d326f7a11323"],
 ") while the remaining food sources drain it equally. Pressures follow from \
Kirchhoff's laws via ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LinearSolve"]], "paclet:ref/LinearSolve"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "52f226a8-3ab9-46b7-9a02-252e0b12c167"],
 " on the weighted graph Laplacian, giving flow ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["Q", "TI"], 
    StyleBox["e", "TI"]], "=", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    SubscriptBox[
     StyleBox["D", "TI"], 
     StyleBox["e", "TI"]], "/", 
    SubscriptBox[
     StyleBox["L", "TI"], 
     StyleBox["e", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1], "\[CapitalDelta]", 
   SubscriptBox[
    StyleBox["p", "TI"], 
    StyleBox["e", "TI"]]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd90f56b-bb83-447f-810a-72e0742778e7"],
 ", and conductivities adapt according to ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   SubscriptBox[
    StyleBox["D", "TI"], 
    StyleBox["e", "TI"]], "/", 
   StyleBox["d", "TI"], 
   StyleBox["t", "TI"], "=", 
   StyleBox["f", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], GridBox[{
     {
      SubscriptBox[
       StyleBox["Q", "TI"], 
       StyleBox["e", "TI"]]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}], 
   StyleBox[")",
    SpanMaxSize->1], "-", 
   SubscriptBox[
    StyleBox["D", "TI"], 
    StyleBox["e", "TI"]]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f7756e88-f580-4cfb-a3ec-ab0bf4603066"],
 "."
}], "Notes",
 CellID->604760901,ExpressionUUID->"9991efbf-b4bc-42f1-9b77-b715814202f1"],

Cell[TextData[{
 "With two food sources and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["f", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["Q", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", GridBox[{
     {
      StyleBox["Q", "TI"]}
    },
    GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
    GridBoxSpacings->{"Columns" -> {{0.15}}}]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "45c751c9-cefe-4bd7-88d2-980549f2fa0d"],
 ", only the shortest path between the two sources survives. With more than \
two food sources and ",
 Cell[BoxData[
  RowBox[{
   StyleBox["f", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["Q", "TI"], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   SuperscriptBox[GridBox[{
      {
       StyleBox["Q", "TI"]}
     },
     GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
     GridBoxSpacings->{"Columns" -> {{0.15}}}], 
    StyleBox["\[Gamma]", "TI"]], "/", 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{"1", "+", 
    SuperscriptBox[GridBox[{
       {
        StyleBox["Q", "TI"]}
      },
      GridBoxDividers->{"Columns" -> {True, True}, "Rows" -> {}},
      GridBoxSpacings->{"Columns" -> {{0.15}}}], 
     StyleBox["\[Gamma]", "TI"]]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26cd545e-5a38-4068-8d98-bd205d53a2e7"],
 ", a fault-tolerant transport network emerges."
}], "Notes",
 CellID->1476799103,ExpressionUUID->"9a4cb2ed-2d0a-4fb9-91b5-18fd2654a28f"],

