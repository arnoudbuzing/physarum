Cell["\<\
Grow a 3D network between random food points around a spherical obstacle in \
the center of the unit cube:\
\>", "ExampleText",
 CellID->1184240770,ExpressionUUID->"8aa8486c-fca3-4208-9299-e1c33634d1ba"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "5", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"food", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0.15", ",", " ", "0.85"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"8", ",", " ", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sim", " ", "=", " ", 
   RowBox[{"PhysarumSimulation3D", "[", 
    RowBox[{"\"\<Classic\>\"", ",", " ", 
     RowBox[{"\"\<Size\>\"", " ", "->", " ", "64"}], ",", "\n", "    ", 
     RowBox[{"\"\<Food\>\"", " ", "->", " ", "food"}], ",", " ", 
     RowBox[{"\"\<FoodStrength\>\"", " ", "->", " ", "50"}], ",", "\n", 
     "    ", 
     RowBox[{"\"\<Walls\>\"", " ", "->", " ", 
      RowBox[{"Ball", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0.5", ",", " ", "0.5", ",", " ", "0.5"}], "}"}], ",", " ", 
        "0.22"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"PhysarumGraphics3D", "[", 
  RowBox[{"PhysarumEvolve", "[", 
   RowBox[{"sim", ",", " ", "400"}], "]"}], "]"}]}], "Input",
