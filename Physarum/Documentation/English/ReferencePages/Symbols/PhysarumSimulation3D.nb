Cell[TextData[{
 Cell[BoxData["PhysarumSimulation3D"], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3a6b9967-2458-45b9-8777-f1a4e20e9643"],
 " returns a ",
