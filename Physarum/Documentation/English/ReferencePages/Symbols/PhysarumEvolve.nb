Cell[TextData[{
 "Each step updates every agent in parallel (sense ",
 Cell[BoxData["\[Rule]"], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "89fae4bb-bf43-4130-b2d8-d5070cf454ac"],
 " rotate ",
 Cell[BoxData["\[Rule]"], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac88ed22-ce5b-477c-9c8c-a1b037a16cad"],
 " move ",
 Cell[BoxData["\[Rule]"], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5c0f2e2-c07f-4bc1-858c-f2f19724a5dc"],
 " deposit), then blurs (",
 Cell[BoxData["\"\<Diffusion\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1c4d4b6b-ed23-41c8-8ea4-73d35448557b"],
 "), decays (",
 Cell[BoxData["\"\<Decay\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a9a1b475-a715-4629-bd65-a693755eae98"],
 ") and adds ",
 Cell[BoxData["\"\<Stimulus\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0263bd46-3183-448c-a141-6ed1d27dfb13"],
 " across the trail map."
}], "Notes",
 CellID->515379898,ExpressionUUID->"bb2cc78d-5a1a-4d1e-9817-ff2fde81cbd7"],

Cell[TextData[{
 "Both 2D (",
 Cell[BoxData["PhysarumSimulationObject"], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20331857-cd38-410c-a71e-e43880d025be"],
 ") and 3D (",
 Cell[BoxData["PhysarumSimulation3DObject"], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed2c3cc6-7e23-4ceb-b9a8-53474dc0ebba"],
 ") simulations are supported."
}], "Notes",
 CellID->604760901,ExpressionUUID->"0792315e-5500-4faa-8baa-3063adf36148"],

Cell[TextData[{
 StyleBox["sim", "TI"],
 " is not modified in place; the returned object has ",
 Cell[BoxData["\"\<Step\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea11f817-bf9e-4453-a657-47d67a4bd23b"],
 " increased by ",
