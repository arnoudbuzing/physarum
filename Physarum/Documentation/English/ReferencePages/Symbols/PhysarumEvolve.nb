Cell["\<\
Fixing the random seed before creating and evolving produces identical trail \
arrays:\
\>", "ExampleText",
 CellID->1555662820,ExpressionUUID->"df867ea7-9ba3-40f8-b07f-667480166163"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a", " ", "=", " ", 
   RowBox[{"PhysarumEvolve", "[", 
    RowBox[{
     RowBox[{"PhysarumSimulation", "[", 
      RowBox[{"\"\<Classic\>\"", ",", " ", 
       RowBox[{"\"\<Size\>\"", " ", "->", " ", "60"}]}], "]"}], ",", " ", 
     "20"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"b", " ", "=", " ", 
   RowBox[{"PhysarumEvolve", "[", 
    RowBox[{
     RowBox[{"PhysarumSimulation", "[", 
      RowBox[{"\"\<Classic\>\"", ",", " ", 
       RowBox[{"\"\<Size\>\"", " ", "->", " ", "60"}]}], "]"}], ",", " ", 
     "20"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a", "[", "\"\<Trail\>\"", "]"}], " ", "==", " ", 
  RowBox[{"b", "[", "\"\<Trail\>\"", "]"}]}]}], "Input",
 CellProlog:>Needs["ArnoudBuzing`Physarum`"],
 CellLabel->"In[1]:=",
 CellID->1943981668,ExpressionUUID->"914dcf5b-1f19-4990-ade0-4bcb41c6ca2c"],

