Cell["\<\
Track the total trail in the grid over successive 10-step blocks:\
\>", "ExampleText",
 CellID->1791983110,ExpressionUUID->"2d673b89-28f6-4c38-90fc-8466a0008791"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sim", " ", "=", " ", 
   RowBox[{"PhysarumSimulation", "[", 
    RowBox[{"\"\<Classic\>\"", ",", " ", 
     RowBox[{"\"\<Size\>\"", " ", "->", " ", "150"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"totals", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Total", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"sim", " ", "=", " ", 
          RowBox[{"PhysarumEvolve", "[", 
           RowBox[{"sim", ",", " ", "10"}], "]"}]}], ")"}], 
        "[", "\"\<Trail\>\"", "]"}], ",", " ", "3"}], "]"}], ",", " ", 
     RowBox[{"{", "30", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"totals", ",", " ", 
   RowBox[{"AxesLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<10-step blocks\>\"", ",", " ", "\"\<total trail\>\""}], 
     "}"}]}]}], "]"}]}], "Input",
 CellProlog:>Needs["ArnoudBuzing`Physarum`"],
 CellLabel->"In[1]:=",
 CellID->86277893,ExpressionUUID->"5c01e17f-941e-4b2e-9308-02ddce3484c0"]
}, Open  ]]
}, Closed]]
