Cell["\<\
Animate it, returning a list of 100 frames, each taken after 10 simulation \
steps. The total simulation steps therefore is 1,000:\
\>", "ExampleText",
 CellChangeTimes->{{3.9997153785723257`*^9, 3.999715391357583*^9}, {
  3.999715427105116*^9, 3.999715511158637*^9}},
 CellID->788188961,ExpressionUUID->"3657ba02-15b1-47d2-b388-0a1ce4f2823d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"frames", "=", 
  RowBox[{"PhysarumAnimate", "[", 
   RowBox[{"obj", ",", "200", ",", "10", ",", 
    RowBox[{"ColorFunction", "->", "\"\<DeepSeaColors\>\""}], ",", 
    RowBox[{"\"\<Output\>\"", "->", "\"\<Video\>\""}]}], "]"}]}]], "Input",
