  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "cd5ffd21-b2ee-4a7b-8a80-8aa86b5b6d5d"],
 " of parameters. Omitted keys use the defaults below:"
}], "Notes",
 CellID->1476799103,ExpressionUUID->"dd3c72e9-9dca-487d-88c7-84cd87afd7eb"],

