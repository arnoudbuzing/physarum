Cell[TextData[{
 "An ",
 StyleBox["agent",
  FontWeight->"Bold"],
 " is a point-sized particle with a 2D position and a heading angle. At each \
step, agents sense the trail map at three sensors ahead, turn toward the \
strongest concentration, move forward, and deposit trail."
}], "Notes",
 CellID->604760901,ExpressionUUID->"bea695a0-ae8f-4a3f-96b0-70083082f1b8"],

Cell[TextData[{
 "A ",
