Cell["\<\
Create a simulation with two competing species of different sensor distances \
and agent fractions:\
\>", "ExampleText",
 CellID->1258921795,ExpressionUUID->"c5a8cfa8-5483-44ae-858a-2931f5930860"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sim", " ", "=", " ", 
   RowBox[{"PhysarumSimulation", "[", 
    RowBox[{
     RowBox[{"<|", "\n", "    ", 
      RowBox[{
       RowBox[{"\"\<Species\>\"", " ", "->", " ", 
        RowBox[{"{", "\n", "        ", 
         RowBox[{
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<SensorDistance\>\"", " ", "->", " ", "12"}], ",", 
            " ", 
            RowBox[{"\"\<Decay\>\"", " ", "->", " ", "0.3"}], ",", " ", 
            RowBox[{"\"\<Diffusion\>\"", " ", "->", " ", "0.1"}], ",", " ", 
            RowBox[{"\"\<Deposit\>\"", " ", "->", " ", "1"}], ",", " ", 
            RowBox[{"\"\<Repulsion\>\"", " ", "->", " ", "2"}], ",", " ", 
            RowBox[{"\"\<Color\>\"", " ", "->", " ", "Orange"}]}], "|>"}], ",",
           "\n", "        ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<SensorDistance\>\"", " ", "->", " ", "25"}], ",", 
            " ", 
            RowBox[{"\"\<Decay\>\"", " ", "->", " ", "0.3"}], ",", " ", 
            RowBox[{"\"\<Diffusion\>\"", " ", "->", " ", "0.1"}], ",", " ", 
            RowBox[{"\"\<Deposit\>\"", " ", "->", " ", "1"}], ",", " ", 
            RowBox[{"\"\<Repulsion\>\"", " ", "->", " ", "2"}], ",", " ", 
            RowBox[{"\"\<Color\>\"", " ", "->", " ", "Cyan"}], ",", " ", 
            RowBox[{"\"\<Fraction\>\"", " ", "->", " ", "2"}]}], "|>"}]}], 
         "\n", "    ", "}"}]}], ",", "\n", "    ", 
       RowBox[{"\"\<AgentDensity\>\"", " ", "->", " ", "1"}]}], "|>"}], ",", 
     " ", 
     RowBox[{"\"\<Size\>\"", " ", "->", " ", "300"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Dimensions", "[", 
  RowBox[{"sim", "[", "\"\<Trail\>\"", "]"}], "]"}]}], "Input",
 CellProlog:>Needs["ArnoudBuzing`Physarum`"],
 CellLabel->"In[1]:=",
 CellID->1615070659,ExpressionUUID->"cd2b4611-4f9e-4153-a2b1-c9a6790805c3"]
}, Open  ]]
}, Closed]],

