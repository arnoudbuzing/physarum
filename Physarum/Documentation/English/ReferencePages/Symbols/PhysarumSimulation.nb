  "36ea435f-442a-4b27-89fc-7c21c8be4e73"],
 "."
}], "Notes",
 CellID->970785311,ExpressionUUID->"a84818cf-e477-4fbd-bfbc-984aed1783d7"],

Cell[TextData[{
 "With multiple species, each species deposits into its own trail layer and \
is repelled by the sum of the other layers weighted by ",
 Cell[BoxData["\"\<Repulsion\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4750d25f-a1c5-400d-adb5-2e20c059fdec"],
 "."
}], "Notes",
 CellID->1377816002,ExpressionUUID->"3235474e-d59d-4a92-83e9-e8072aabf05c"],

