Cell[TextData[{
 "A full specification (the form stored in ",
 Cell[BoxData["$PhysarumPresets"], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c6b52fd1-b04c-47b9-9ff0-47f90e38852d"],
 ") is an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Association"]], "paclet:ref/Association"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "119615a1-ec97-45cc-a1f1-867849b6d59c"],
 " with ",
 Cell[BoxData["\"\<Species\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b013152-0ab3-4d06-b960-6beb16ff2030"],
 " and optional keys ",
 Cell[BoxData["\"\<AgentDensity\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d0f8e2bc-1c9c-4c6a-9e44-8394e2c70d06"],
 ", ",
 Cell[BoxData["\"\<Steps\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0e9f7c7f-e654-41b1-9ad1-d77b495bf984"],
 ", ",
 Cell[BoxData["\"\<Initialization\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7e52841b-e428-4927-9dcd-3f6a58420a33"],
 ", ",
 Cell[BoxData["\"\<Wrap\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e57c83d-675a-40d0-86ce-a58d8d790be8"],
 ", ",
 Cell[BoxData["\"\<ColorFunction\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d4028e70-f93e-42c4-bc17-bbe5da875a6d"],
 ", ",
 Cell[BoxData["\"\<Background\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "12d6a032-b750-448e-af7a-d566061410e0"],
 ", ",
 Cell[BoxData["\"\<Gamma\>\""], "InlineFormula",
