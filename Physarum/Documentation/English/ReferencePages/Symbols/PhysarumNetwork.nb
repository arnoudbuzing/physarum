Cell["\<\
Grow a rail-like network between Dutch cities and display it on a map:\
\>", "ExampleText",
 CellID->1245349523,ExpressionUUID->"880bdb0a-ca10-4e92-b0b7-e20775af82b7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"cities", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Entity", "[", 
      RowBox[{"\"\<City\>\"", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", 
    " ", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<Amsterdam\>\"", ",", " ", "\"\<NoordHolland\>\"", ",", 
        " ", "\"\<Netherlands\>\""}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"\"\<Rotterdam\>\"", ",", " ", "\"\<ZuidHolland\>\"", ",", 
        " ", "\"\<Netherlands\>\""}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"\"\<TheHague\>\"", ",", " ", "\"\<ZuidHolland\>\"", ",", 
        " ", "\"\<Netherlands\>\""}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"\"\<Utrecht\>\"", ",", " ", "\"\<Utrecht\>\"", ",", 
        " ", "\"\<Netherlands\>\""}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"\"\<Eindhoven\>\"", ",", " ", "\"\<NoordBrabant\>\"", ",", 
        " ", "\"\<Netherlands\>\""}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"\"\<Groningen\>\"", ",", " ", "\"\<Groningen\>\"", ",", 
        " ", "\"\<Netherlands\>\""}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"\"\<Zwolle\>\"", ",", " ", "\"\<Overijssel\>\"", ",", 
        " ", "\"\<Netherlands\>\""}], "}"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"\"\<Maastricht\>\"", ",", " ", "\"\<Limburg\>\"", ",", 
        " ", "\"\<Netherlands\>\""}], "}"}]}], "\n", "}"}]}]}], ";"}], "\n", 
 RowBox[{"PhysarumNetwork", "[", 
  RowBox[{"cities", ",", " ", 
   RowBox[{"\"\<Output\>\"", " ", "->", " ", "\"\<GeoGraphics\>\""}], ",", 
   " ", 
   RowBox[{"\"\<Backbone\>\"", " ", "->", " ", "True"}]}], "]"}]}], "Input",
 CellProlog:>Needs["ArnoudBuzing`Physarum`"],
 CellLabel->"In[1]:=",
