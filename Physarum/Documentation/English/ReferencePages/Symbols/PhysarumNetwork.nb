Cell[TextData[{
 Cell[BoxData["PhysarumNetwork"], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bbac5397-a1c7-4477-b3fb-71218ac484cd"],
 " runs an agent simulation with food placed at the input locations, \
thresholds and thins the resulting trail map into a 1-pixel skeleton, and \
traces the skeleton into a weighted ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Graph"]], "paclet:ref/Graph"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "151bac6c-20b5-46a3-afcf-98f471afe1e6"],
 " with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["EuclideanDistance"]], "paclet:ref/EuclideanDistance"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "c4645b1d-4eeb-4ad3-8bfb-3d455072fa20"],
 " edge weights."
}], "Notes",
 CellID->515379898,ExpressionUUID->"aa4f878f-a7fd-45af-b8ae-f4e7e0c60da5"],

Cell[TextData[{
 "Geographic inputs (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["GeoPosition"]], "paclet:ref/GeoPosition"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "0391e3f7-1a0e-4f31-a794-1bf0bafe0b72"],
 " or ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["Entity"]], "paclet:ref/Entity"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "247af390-3ce6-4628-ac67-db58798ce3a3"],
 " values such as cities) are projected using an equirectangular projection \
at the mean latitude and attached as vertices of the resulting graph."
}], "Notes",
 CellID->604760901,ExpressionUUID->"760a99b3-61c4-4de2-a240-c6b8784978fb"],

