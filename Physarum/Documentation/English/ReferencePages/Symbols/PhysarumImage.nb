Cell["Highlight food sources on top of the trail map:", "ExampleText",
 CellID->484948520,ExpressionUUID->"1ae8455a-4d85-47fd-b5a0-b62639548e0b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "5", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"food", " ", "=", " ", 
   RowBox[{"RandomReal", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0.15", ",", " ", "0.85"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"9", ",", " ", "2"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"foraging", " ", "=", " ", 
   RowBox[{"PhysarumEvolve", "[", 
    RowBox[{
     RowBox[{"PhysarumSimulation", "[", 
      RowBox[{"\"\<Classic\>\"", ",", " ", 
       RowBox[{"\"\<Size\>\"", " ", "->", " ", "220"}], ",", " ", 
       RowBox[{"\"\<Food\>\"", " ", "->", " ", "food"}], ",", " ", 
       RowBox[{"\"\<FoodStrength\>\"", " ", "->", " ", "50"}]}], "]"}], ",", 
     " ", "500"}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"PhysarumImage", "[", "foraging", "]"}], ",", " ", 
   RowBox[{"PhysarumImage", "[", 
    RowBox[{"foraging", ",", " ", 
     RowBox[{"\"\<ShowFood\>\"", " ", "->", " ", "True"}]}], "]"}]}], 
  "}"}]}], "Input",
