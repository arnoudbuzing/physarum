Cell[TextData[{
 "Each species' trail layer is normalized so that the ",
 Cell[BoxData["\"\<Clip\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b70745b-5c00-4623-8bc9-ff6268303637"],
 " quantile maps to ",
 Cell[BoxData["1"], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "746353f0-d9fe-4f6a-9c9c-e9d7c560be7b"],
 ", then gamma-corrected by ",
 Cell[BoxData["\"\<Gamma\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "39006b59-58df-4ea8-80bd-2aab437797d4"],
 ". Cells containing food are excluded when computing the normalization \
quantile so bright food sources do not wash out the network."
}], "Notes",
 CellID->604760901,ExpressionUUID->"beae044e-5a4a-471d-be26-4885d8583884"],

Cell[TextData[{
 "With a single species and a ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ColorFunction"]], "paclet:ref/ColorFunction"},
   "RefLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "f1a7c17a-3604-4861-b93e-d575cc9c2c89"],
 ", trail intensity in ",
 Cell[BoxData[
  RowBox[{
   StyleBox["[",
    SpanMaxSize->1], 
   RowBox[{"0", ",", "1"}], 
   StyleBox["]",
    SpanMaxSize->1]}]], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd7be589-83c2-4eba-a3ec-8bf01bf9b5ad"],
 " is passed to the color function. Otherwise, each species is colored by ",
 Cell[BoxData["\"\<Colors\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "331427c6-c31e-4a3e-847c-74ba1486f05f"],
 " (additive blending on dark backgrounds, subtractive ink-like blending on \
light backgrounds)."
}], "Notes",
 CellID->1476799103,ExpressionUUID->"31e1dc05-479e-4fef-a6ed-e7b8f71d564d"],

