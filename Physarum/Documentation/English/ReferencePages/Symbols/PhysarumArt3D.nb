 CellID->542210380,ExpressionUUID->"c679ca8f-eac0-4b43-aaf2-9730580b93c0"],

Cell[BoxData[
 RowBox[{"PhysarumArt3D", "[", 
  RowBox[{
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<SensorAngle\>\"", " ", "->", " ", 
      RowBox[{"45", " ", "Degree"}]}], ",", " ", 
