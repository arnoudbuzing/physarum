Cell[BoxData[
 RowBox[{"PhysarumArt", "[", 
  RowBox[{
   RowBox[{"<|", "\n", "    ", 
    RowBox[{
     RowBox[{"\"\<Species\>\"", " ", "->", " ", 
      RowBox[{"{", "\n", "        ", 
       RowBox[{
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<SensorDistance\>\"", " ", "->", " ", "12"}], ",", " ", 
          
          RowBox[{"\"\<Diffusion\>\"", " ", "->", " ", "0.1"}], ",", " ", 
          RowBox[{"\"\<Decay\>\"", " ", "->", " ", "0.3"}], ",", " ", 
          RowBox[{"\"\<Deposit\>\"", " ", "->", " ", "1"}], ",", " ", 
          RowBox[{"\"\<Repulsion\>\"", " ", "->", " ", "2"}], ",", " ", 
          RowBox[{"\"\<Color\>\"", " ", "->", " ", "Orange"}]}], "|>"}], ",", 
        "\n", "        ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<SensorDistance\>\"", " ", "->", " ", "25"}], ",", " ", 
          
          RowBox[{"\"\<Diffusion\>\"", " ", "->", " ", "0.1"}], ",", " ", 
          RowBox[{"\"\<Decay\>\"", " ", "->", " ", "0.3"}], ",", " ", 
          RowBox[{"\"\<Deposit\>\"", " ", "->", " ", "1"}], ",", " ", 
          RowBox[{"\"\<Repulsion\>\"", " ", "->", " ", "2"}], ",", " ", 
          RowBox[{"\"\<Color\>\"", " ", "->", " ", "Cyan"}], ",", " ", 
          RowBox[{"\"\<Fraction\>\"", " ", "->", " ", "2"}]}], "|>"}]}], "\n",
        "    ", "}"}]}], ",", "\n", "    ", 
     RowBox[{"\"\<AgentDensity\>\"", " ", "->", " ", "1"}]}], "|>"}], ",", 
   " ", 
   RowBox[{"\"\<Steps\>\"", " ", "->", " ", "600"}]}], "]"}]], "Input",
