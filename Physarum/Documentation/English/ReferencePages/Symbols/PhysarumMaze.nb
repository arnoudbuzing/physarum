Cell[TextData[{
 Cell[BoxData["PhysarumMaze"], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "680d7d08-344a-4f91-af8c-d09872886f12"],
 " uses a randomized depth-first recursive backtracker starting at the \
top-left cell to generate a perfect spanning-tree maze, then opens ",
 Cell[BoxData["\"\<Loops\>\""], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bac56885-9780-4c0e-b04b-cca845668290"],
 " additional interior walls to create competing paths for ",
 Cell[BoxData["PhysarumFlow"], "InlineFormula",
  FontFamily->"Source Sans Pro",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf0fd10f-8114-425b-9b3d-79977ae49d5b"],
 "."
}], "Notes",
 CellID->604760901,ExpressionUUID->"6009e42a-4626-4113-aa5f-c18f1de214e2"],

