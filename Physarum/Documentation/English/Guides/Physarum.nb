Cell["Physarum", "GuideTitle",
 CellID->942062912,ExpressionUUID->"a577d308-e80a-483e-99a5-dd9472f11f97"],

Cell[TextData[{
 Cell["ArnoudBuzing/Physarum", "InlineCode",
  FontFamily->"Source Sans Pro",ExpressionUUID->
  "ba65d47d-05dd-4047-a992-c540a5523c61"],
 " simulates the slime mold ",
 StyleBox["Physarum polycephalum", "TI"],
 " using two classic models: Jeff Jones's multi-agent trail model (in 2D and \
3D) for emergent pattern formation and generative art, and Tero ",
 StyleBox["et al.", "TI"],
 "'s adaptive tube-flow model for maze solving and transport networks."
}], "GuideAbstract",
 CellID->329621944,ExpressionUUID->"306980bd-6d90-4b1a-912c-402fbbb3392a"],

